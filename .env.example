HOURLY_CONNECTORS=hn,github_issues
DAILY_CONNECTORS=greenhouse,lever,reddit,yc_companies,producthunt,appstore_trending,indiehackers
ENABLE_JOB_CONNECTORS=true

# Optional open-source config (set tokens to enable)
GREENHOUSE_BOARD_TOKEN=
LEVER_SITE=

# Optional BYO connectors
EXA_API_KEY=
PERIGON_API_KEY=
EXA_DAILY_BUDGET_USD=5
PERIGON_DAILY_BUDGET_USD=5

# AI judge runtime (CLI subscriptions)
AI_PROVIDER=both
AI_PROVIDER_PRIMARY=claude
AI_PROVIDER_MODE=single
AI_PROVIDER_FALLBACK=false
AI_PROVIDER_RETRIES=1
AI_POST_SCRAPE_ENABLED=true
AI_POST_SCRAPE_MAX_SIGNALS=80
AI_POST_SCRAPE_TIMEOUT_MS=180000
AI_JUDGE_MAX_SIGNALS=0
AI_JUDGE_TIMEOUT_MS=180000

# Circuit breaker (auto-skips failing providers)
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=600000

REDIS_URL=redis://127.0.0.1:6391
DATABASE_URL=postgresql://idea_ai:idea_ai_dev@127.0.0.1:5917/idea_ai
HOST=127.0.0.1
# Set HOST=0.0.0.0 and API_KEY=<secret> for LAN/network access
PORT=3000

# Execution logging
LOG_DIR=./logs/executions
# RUN_ID=

# Web app
VITE_API_URL=http://127.0.0.1:3000
# Auth — must match API_KEY when set
VITE_API_KEY=

# --- V2 Configuration ---

# Ollama (local embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Security
# API_KEY is required when HOST != 127.0.0.1 (any non-localhost deployment)
# API_KEY=
# CORS_ORIGINS defaults to localhost:5173 — override for production
# CORS_ORIGINS=http://localhost:5173
# RATE_LIMIT_MAX=100

# Bayesian confidence engine
BAYESIAN_PRIOR_DEFAULT=20
BAYESIAN_DECAY_RATE=0.97
BAYESIAN_DECAY_AFTER_DAYS=14
BAYESIAN_FLOOR_CONFIDENCE=5

# Temporal RAG (recency-weighted retrieval)
TEMPORAL_RAG_WEIGHT=0.3
TEMPORAL_RAG_HALF_LIFE_HOURS=72

# Phase 2: Intelligence Amplification
DEBATE_CONFIDENCE_THRESHOLD=40
DEBATE_MAX_PER_RUN=5
BACKTEST_SNAPSHOT_INTERVAL_MS=604800000
BACKTEST_VALIDATE_AFTER_DAYS=30
CUSUM_THRESHOLD=5
CUSUM_DRIFT=1
CATEGORY_MIN_PHRASE_COUNT=3

# Phase 3: Self-Improving Intelligence
MODEL_ROUTING_ENABLED=false
OLLAMA_CHEAP_MODEL=llama3.2:3b
OLLAMA_MEDIUM_MODEL=qwen2.5:7b
OLLAMA_TASK_TIMEOUT_MS=30000
WEIGHT_OPT_ENABLED=true
WEIGHT_OPT_MIN_PREDICTIONS=50
WEIGHT_OPT_MIN_IMPROVEMENT=0.05
WEIGHT_OPT_GRID_STEP=0.05
