# Connectors
HOURLY_CONNECTORS=hn,github_issues,showhn
DAILY_CONNECTORS=greenhouse,lever,reddit,yc_companies,producthunt,appstore_trending,betalist,indiehackers,lobsters,devto,mastodon,homebrew,google_trends,stackoverflow,g2_reviews,npm_trends,semantic_scholar
B2B_SUBREDDITS=devops,sysadmin,ITManagers,msp,salesforce,aws,googlecloud,azure,ExperiencedDevs
ENABLE_JOB_CONNECTORS=true

# Open-source connector config
GREENHOUSE_BOARD_TOKEN=stripe
LEVER_SITE=plaid

# Optional BYO connectors
EXA_API_KEY=
PERIGON_API_KEY=
EXA_DAILY_BUDGET_USD=0
PERIGON_DAILY_BUDGET_USD=0
X_BEARER_TOKEN=
X_DAILY_BUDGET_USD=0

# AI: codex primary, claude fallback, 5 min timeout
AI_PRIMARY=codex
AI_FALLBACK=none
AI_RETRIES=1
AI_TIMEOUT_MS=300000
DEBATE_ENABLED=false

# AI post-scrape (enriches signals after ingestion)
AI_POST_SCRAPE_ENABLED=true
AI_POST_SCRAPE_MAX_SIGNALS=80

# Circuit breaker (auto-skips failing providers)
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=600000

# Connector concurrency (max parallel connector fetches per refresh)
CONNECTOR_CONCURRENCY=5

# Infrastructure
REDIS_URL=redis://127.0.0.1:6391
DATABASE_URL=postgresql://idea_ai:idea_ai_dev@127.0.0.1:5917/idea_ai
HOST=127.0.0.1
PORT=3001
LOG_DIR=./logs/executions

# Web app
VITE_API_URL=http://127.0.0.1:3001
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
# Auth — must match API_KEY when set
VITE_API_KEY=

# Security
# API_KEY is required when HOST != 127.0.0.1 (any non-localhost deployment)
# API_KEY=
# CORS_ORIGINS defaults to localhost:5173 — override for production
# CORS_ORIGINS=http://localhost:5173

# Ollama (local embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Connector refresh schedules (independent of research agent)
CONNECTOR_REFRESH_MS=3600000
CONNECTOR_DAILY_REFRESH_MS=86400000

# Research agent (independent schedule)
AGENT_INTERVAL_MS=3600000
AGENT_MAX_CLUSTERS=50

# Bayesian confidence engine
BAYESIAN_PRIOR_DEFAULT=20
BAYESIAN_DECAY_RATE=0.97
BAYESIAN_DECAY_AFTER_DAYS=14
BAYESIAN_FLOOR_CONFIDENCE=5

# Backtesting & drift detection
BACKTEST_SNAPSHOT_INTERVAL_MS=604800000
BACKTEST_VALIDATE_AFTER_DAYS=30
CUSUM_THRESHOLD=5
CUSUM_DRIFT=1
CATEGORY_MIN_PHRASE_COUNT=3

# Model routing (experimental)
MODEL_ROUTING_ENABLED=false
OLLAMA_CHEAP_MODEL=llama3.2:3b
OLLAMA_MEDIUM_MODEL=qwen2.5:7b
OLLAMA_TASK_TIMEOUT_MS=30000

# Weight optimization
WEIGHT_OPT_ENABLED=true
WEIGHT_OPT_MIN_PREDICTIONS=50
WEIGHT_OPT_MIN_IMPROVEMENT=0.05
WEIGHT_OPT_GRID_STEP=0.05
